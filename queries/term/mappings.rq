# Codes in other terminologies, from every source. A row with several source badges means the sources agree.
# "exact": stated as the same concept (an ontology's exact match, a Wikidata external ID, TogoID "is equivalent to");
# "close": TogoID "is nearly equivalent to"; "broad" / "narrow": Orphanet's NTBT / BTNT (the code is broader / narrower); "xref": a database cross-reference.
# "checkedName" / "status" / "checkedIn": the code as EBI's OLS (or, for NANDO, RDF Portal) has it: current, obsolete
# or not found. Empty where neither covers the terminology (ICD, OMIM, …).
SELECT (SAMPLE(?voc) AS ?vocabulary) ?code (SAMPLE(?c) AS ?codeLabel)
       (GROUP_CONCAT(DISTINCT ?rel; separator=", ") AS ?relation) (GROUP_CONCAT(DISTINCT ?src; separator=" ") AS ?sources)
       (SAMPLE(?name) AS ?checkedName) (SAMPLE(?st) AS ?status) (SAMPLE(?by) AS ?checkedIn) (SAMPLE(?replaced) AS ?replacedBy) WHERE {
  { GRAPH ?g { <{{iri}}> skos:exactMatch ?code } BIND("exact" AS ?rel) }
  UNION
  { GRAPH ?g { <{{iri}}> skos:closeMatch ?code } BIND("close" AS ?rel) }
  UNION
  { GRAPH ?g { <{{iri}}> skos:broadMatch ?code } BIND("broad" AS ?rel) }
  UNION
  { GRAPH ?g { <{{iri}}> skos:narrowMatch ?code } BIND("narrow" AS ?rel) }
  UNION
  { GRAPH ?g { <{{iri}}> oboInOwl:hasDbXref ?code } BIND("xref" AS ?rel) }
  OPTIONAL { ?code kr:vocabulary ?voc }
  OPTIONAL { ?code kr:code ?c }
  OPTIONAL {
    GRAPH ?cg { ?code kr:checkStatus ?st }
    OPTIONAL { GRAPH ?cg { ?code kr:checkedName ?name } }
    OPTIONAL { GRAPH ?cg { ?code obo:IAO_0100001 ?replaced } }
    BIND(IF(?cg = <urn:koetai-reconciliator:source:ols>, "OLS", "RDF Portal") AS ?by)
  }
  BIND(STRAFTER(STR(?g), "urn:koetai-reconciliator:source:") AS ?src)
} GROUP BY ?code ORDER BY ?vocabulary ?codeLabel
